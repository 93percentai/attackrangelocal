# Copy this file to .env (project root) and fill in every value.
# .env is git-ignored. iso/build-iso.sh refuses to run if any required value is empty.

# ---------------------------------------------------------------------------
# REQUIRED — Range identity
# ---------------------------------------------------------------------------
# Numeric 1-255. Used as the second octet of the lab subnet (10.<RANGE_ID>.20.0/24)
# and as a prefix for every VM name in Proxmox.
RANGE_ID=42

# RANGE_MODE selects which range-config template gets deployed.
#   full     7 VMs (dc + 2 win members + splunk + elastic + linux + kali)
#            Needs ~30 GB RAM / 16 threads / 500 GB.
#   minimal  5 VMs (combined dc/server + win client + splunk + linux + kali)
#            Fits 16 GB RAM / 12 threads / 256 GB. No Elastic, no winsrv1.
RANGE_MODE=full

# ---------------------------------------------------------------------------
# REQUIRED — Tailscale
# ---------------------------------------------------------------------------
# Reusable auth key (Settings -> Keys -> Generate auth key, mark "Reusable").
# Used to join every lab VM AND the Proxmox host itself to your tailnet.
TS_AUTHKEY=tskey-auth-REPLACE_ME

# API key with device-removal permissions (Settings -> Keys -> Generate API key).
# Needed by NocteDefensor.ludus_tailscale to deregister VMs on teardown.
TS_API_KEY=tskey-api-REPLACE_ME

# Tag applied to every device joined by this range. Define matching ACL rules
# in your tailnet (see docs/tailscale-acls.md).
TS_TAG=tag:lab-range

# ---------------------------------------------------------------------------
# REQUIRED — Active Directory
# ---------------------------------------------------------------------------
AD_DOMAIN_FQDN=range.local
AD_DOMAIN_ADMIN=rangeadmin
AD_PASSWORD=REPLACE_ME_strong_pw_16chars_min

# ---------------------------------------------------------------------------
# REQUIRED — Ludus / Proxmox
# ---------------------------------------------------------------------------
# Set as the Proxmox root password by the unattended Proxmox installer.
LUDUS_ADMIN_PASSWORD=REPLACE_ME_strong_pw_16chars_min

# Authorized SSH key for root@proxmox. Paste the contents of ~/.ssh/id_ed25519.pub
# (or any pubkey you want to use for emergency console access).
OPERATOR_SSH_PUBKEY="ssh-ed25519 AAAA... operator@laptop"

# ---------------------------------------------------------------------------
# OPTIONAL — Notifications
# ---------------------------------------------------------------------------
# Slack/Discord webhook URL. If set, first-boot.sh POSTs phase transitions here.
NOTIFY_WEBHOOK=

# ---------------------------------------------------------------------------
# OPTIONAL — Continuous simulation
# ---------------------------------------------------------------------------
# Comma-separated MITRE technique IDs to NEVER run in the random loop.
# Defaults exclude destructive techniques.
SIM_EXCLUDE=T1485,T1486,T1490,T1491,T1561,T1565,T1529,T1499,T1496
SIM_INTERVAL_MINUTES=30

# ---------------------------------------------------------------------------
# OPTIONAL — Extended attack tooling + defused malware samples
# ---------------------------------------------------------------------------
# CALDERA server (MITRE) admin password — runs on kali on port 8888.
CALDERA_PASSWORD=changeme_caldera_admin_pw

# abuse.ch MalwareBazaar Auth-Key. Free at https://bazaar.abuse.ch/account/.
# When set, scripts/install-extended-attacks.sh pulls a curated set of
# DEFUSED (password-protected ZIP) samples to C:\Quarantine on win-client1.
# Leave empty to skip the pull entirely (EICAR + APT Simulator + PurpleSharp
# install regardless — those don't need a key).
MALWARE_BAZAAR_API_KEY=

# Password the pulled archives use. abuse.ch default is "infected".
MALWARE_ARCHIVE_PASSWORD=infected

# Set to 1 to skip malware-samples.yml even if the API key above is set.
SKIP_MALWARE_SAMPLES=0

# ---------------------------------------------------------------------------
# OPTIONAL — Elastic stack (second SIEM alongside Splunk)
# ---------------------------------------------------------------------------
# Default admin password for the `elastic` superuser + Kibana.
# Used by ansible/elastic-stack.yml.
ELASTIC_PASSWORD=changeme_elastic_16chars
KIBANA_ENCRYPTION_KEY=changeme_32_byte_key_for_kibana_xpack_encrypted_savedobj

# Pinned Elastic version. Single-node mode.
ELASTIC_VERSION=8.15.0

# ---------------------------------------------------------------------------
# OPTIONAL — Extra Splunk users
# ---------------------------------------------------------------------------
# Inline simple format: user:password:role[,user:password:role]...
# Roles: admin | power | user
# Example: SPLUNK_USERS=alice:Wxy!Zzz123:admin,bob:Bbb!Bb33:power,charlie:Cc!Cc44:user
# Leave empty to skip. For more advanced setups (SSO, LDAP, per-app caps,
# index ACLs), edit ludus/splunk-users.yml directly.
SPLUNK_USERS=
SPLUNK_ADMIN_PASSWORD=changeme123!

---
import StatusBadge from "@/components/StatusBadge.astro";
import type { VmStatus } from "@/lib/ludus";
interface Props { vm: VmStatus }
const { vm } = Astro.props as Props;

const proxTone = vm.proxmox_state === "running" ? "ok" : vm.proxmox_state === "stopped" ? "danger" : "muted";
const tsTone   = vm.tailscale_state === "online" ? "ok" : vm.tailscale_state === "offline" ? "danger" : "muted";
---

<div class="card card-pad space-y-3">
  <div class="flex items-baseline justify-between gap-3">
    <div>
      <div class="font-mono text-sm text-accent">{vm.fqdn}</div>
      <div class="text-xs text-muted">{vm.role} · {vm.os}</div>
    </div>
    <div class="flex flex-col items-end gap-1.5">
      <StatusBadge tone={proxTone} label={`vm: ${vm.proxmox_state}`} />
      <StatusBadge tone={tsTone}   label={`ts: ${vm.tailscale_state}`} />
    </div>
  </div>

  <dl class="grid grid-cols-2 gap-x-4 gap-y-1 text-xs">
    <dt class="h-label">VLAN IP</dt>
    <dd class="font-mono text-ink text-right">{vm.vlan_ip}</dd>
    <dt class="h-label">Tailscale</dt>
    <dd class="font-mono text-ink text-right">{vm.tailscale_ip ?? "—"}</dd>
    <dt class="h-label">Resources</dt>
    <dd class="font-mono text-ink text-right">{vm.cpu} vCPU · {vm.ram} GB</dd>
  </dl>
</div>

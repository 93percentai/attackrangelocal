---
import "@/styles/global.css";
import Header from "@/components/Header.astro";
import { RANGE } from "@/lib/ludus";
interface Props { title?: string; lead?: string }
const { title = "attackrangelocal", lead } = Astro.props as Props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="robots" content="noindex" />
    <title>{title}</title>
  </head>
  <body>
    <Header />
    <main class="mx-auto max-w-6xl px-6 py-8 space-y-8">
      {lead && (
        <div>
          <h1 class="text-2xl">{title}</h1>
          <p class="mt-1 max-w-3xl text-sm text-muted">{lead}</p>
        </div>
      )}
      <slot />
    </main>
    <footer class="mx-auto max-w-6xl px-6 pb-10 pt-4 text-xs text-muted flex justify-between">
      <span>local_ludus · Splunk Attack Range v5</span>
      <span class="font-mono">range #{RANGE.id}</span>
    </footer>
  </body>
</html>

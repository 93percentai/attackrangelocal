---
import BaseLayout from "@/layouts/BaseLayout.astro";
import StatusBadge from "@/components/StatusBadge.astro";
import { getBootstrapPhase } from "@/lib/ludus";

const phase = await getBootstrapPhase();
const lockedDown = phase === "lockdown-applied" || phase === "range-up-continuous-sim-running";
---
<BaseLayout
  title="Network isolation"
  lead="The Ludus router defaults to DROP. After lockdown, no lab VM can reach the public internet — only Tailscale UDP and DNS escape the VLAN."
>
  <section class="card card-pad">
    <div class="flex items-baseline justify-between">
      <div>
        <h2 class="text-lg">Lockdown state</h2>
        <p class="text-xs text-muted mt-0.5">Current bootstrap phase: <span class="font-mono">{phase}</span></p>
      </div>
      <StatusBadge tone={lockedDown ? "ok" : "warn"} label={lockedDown ? "locked down" : "bootstrap window"} />
    </div>

    <div class="mt-4 grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
      <div>
        <div class="h-label">Permanently allowed egress</div>
        <ul class="mt-1 space-y-1 font-mono text-xs text-ink">
          <li>UDP/41641 → tailscale direct probes</li>
          <li>UDP/53    → DNS via router only</li>
        </ul>
      </div>
      <div>
        <div class="h-label">Hard-blocked networks</div>
        <ul class="mt-1 space-y-1 font-mono text-xs text-ink">
          <li>10.0.0.0/8</li>
          <li>172.16.0.0/12</li>
          <li>192.168.0.0/16</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="card card-pad space-y-3">
    <div class="flex items-baseline justify-between">
      <h2 class="text-lg">Run isolation check</h2>
      <p class="text-xs text-muted">SSHes into every VM and confirms egress is dead</p>
    </div>
    <div>
      <button id="run-check" class="btn btn-primary">▶  Run verify-isolation.sh</button>
      <span id="check-status" class="ml-3 text-xs text-muted"></span>
    </div>
    <pre id="check-log" class="hidden card-pad rounded-md bg-panel2/40 border border-line font-mono text-xs whitespace-pre-wrap text-ink"></pre>
  </section>

  <script>
    document.getElementById("run-check")?.addEventListener("click", async () => {
      const btn = document.getElementById("run-check") as HTMLButtonElement;
      const log = document.getElementById("check-log")!;
      const sts = document.getElementById("check-status")!;
      btn.disabled = true;
      sts.textContent = "running… can take 30s";
      log.classList.remove("hidden");
      log.textContent = "";
      try {
        const r = await fetch("/api/isolation", { method: "POST" });
        const data = await r.json();
        sts.textContent = data.ok ? "PASS · all VMs locked down" : "FAIL · see log";
        sts.className = "ml-3 text-xs " + (data.ok ? "text-ok" : "text-danger");
        log.textContent = data.log;
      } catch (e) {
        sts.textContent = "error";
        log.textContent = String(e);
      } finally {
        btn.disabled = false;
      }
    });
  </script>
</BaseLayout>
